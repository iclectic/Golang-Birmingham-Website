# Server Configuration
PORT=8080
BASE_URL=http://localhost:8080
ENVIRONMENT=development

# Contact Information
CONTACT_EMAIL=conduct@example.com
SPEAKER_FORM_URL=https://forms.example.com/speaker

# Social Media Links
MEETUP_URL=https://meetup.com/golang-birmingham
LINKEDIN_URL=https://linkedin.com/company/golang-birmingham
YOUTUBE_URL=https://youtube.com/@golangbirmingham
GITHUB_URL=https://github.com/golang-birmingham

# Security Configuration
CSRF_SECRET=change-this-to-a-random-string-in-production
SESSION_SECRET=change-this-to-a-random-string-in-production
ENABLE_HTTPS=false

# Email Configuration (for contact forms)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@golangbirmingham.com

# Analytics (optional)
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_NEWSLETTER=false
ENABLE_DONATIONS=false
